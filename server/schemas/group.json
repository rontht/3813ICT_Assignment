{
  "bsonType": "object",
  "required": ["id", "name", "creator", "channels", "members", "requests"],
  "properties": {
    "id": {
      "bsonType": "string",
      "description": "Unique group identifier (e.g., g001)"
    },
    "name": {
      "bsonType": "string",
      "description": "Display name of the group"
    },
    "creator": {
      "bsonType": "string",
      "description": "Username of the group creator"
    },
    "channels": {
      "bsonType": "array",
      "items": { "bsonType": "string" },
      "description": "Array of channel IDs belonging to this group"
    },
    "members": {
      "bsonType": "array",
      "items": { "bsonType": "string" },
      "description": "Array of usernames who are members of the group"
    },
    "requests": {
      "bsonType": "array",
      "items": { "bsonType": "string" },
      "description": "Usernames of users requesting to join the group"
    }
  }
}
