{
  "bsonType": "object",
  "required": ["username", "name", "email", "password", "role"],
  "properties": {
    "username": {
      "bsonType": "string",
      "description": "Unique username for login"
    },
    "name": {
      "bsonType": "string",
      "description": "Display name"
    },
    "email": {
      "bsonType": "string",
      "description": "Email address"
    },
    "password": {
      "bsonType": "string",
      "minLength": 3,
      "description": "Password"
    },
    "role": {
      "bsonType": "string",
      "enum": ["super-admin", "group-admin", "user"],
      "description": "Access role"
    },
    "avatar": {
      "bsonType": "string",
      "description": "URL of user avatar image",
      "maxLength": 500
    }
  }
}
